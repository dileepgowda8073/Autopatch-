# ── LLM Provider ──────────────────────────────────────────────────────────
AUTOPATCH_LLM_PROVIDER=gemini          # gemini | openai

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Backend Configuration ─────────────────────────────────────────────────
AUTOPATCH_ENV=development              # development | production
AUTOPATCH_HOST=0.0.0.0
AUTOPATCH_PORT=8000
AUTOPATCH_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# ── Database ──────────────────────────────────────────────────────────────
AUTOPATCH_DB_URL=sqlite+aiosqlite:///./data/autopatch.db

# ── Upload Security Limits ────────────────────────────────────────────────
AUTOPATCH_MAX_UPLOAD_BYTES=52428800   # 50 MB
AUTOPATCH_MAX_ZIP_FILES=500
AUTOPATCH_MAX_UNCOMPRESSED_BYTES=209715200  # 200 MB

# ── Workspace Storage ─────────────────────────────────────────────────────
AUTOPATCH_WORKSPACE_ROOT=./data/workspaces
AUTOPATCH_WORKSPACE_TTL_SECONDS=3600  # 1 hour

# ── Sandbox (Docker Container) ───────────────────────────────────────────
AUTOPATCH_SANDBOX_IMAGE=autopatch-sandbox:latest
AUTOPATCH_SANDBOX_CPU_QUOTA=0.5       # fraction of 1 CPU
AUTOPATCH_SANDBOX_MEMORY_MB=256
AUTOPATCH_SANDBOX_TIMEOUT_SECONDS=120
AUTOPATCH_SANDBOX_MAX_OUTPUT_BYTES=1048576  # 1 MB

# ── LLM Reasoning Behavior ────────────────────────────────────────────────
AUTOPATCH_LLM_MAX_RETRIES=3
AUTOPATCH_LLM_TEMPERATURE=0.2
AUTOPATCH_LLM_MAX_TOKENS=4096
AUTOPATCH_LLM_CACHE_ENABLED=true

# ── Rate Limiting ─────────────────────────────────────────────────────────
AUTOPATCH_RATE_LIMIT_PER_MINUTE=60

# ── Frontend (Vite) ───────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MOCK_MODE=true
